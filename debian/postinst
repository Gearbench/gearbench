#!/bin/sh
set -e

# Made before the udev reload: udev drops a rule line that names a group not yet there, and
# 70-g502x.rules grants the G502 X PLUS's event nodes to this one. The package adds no account,
# since it cannot know who uses the mouse. The group is the one the package's sysusers.d
# file names; debhelper's own call of systemd-sysusers would come with its other snippets,
# after the reload.
make_group() {
    # In another root (DPKG_ROOT, a chrootless install) the group goes in that root's
    # /etc/group, and the host's udev is left alone: that root's udev reads the rules at boot.
    if [ -n "$DPKG_ROOT" ]; then
        grep -q '^gearbench:' "$DPKG_ROOT/etc/group" && return 0
        systemd-sysusers --root="$DPKG_ROOT" gearbench.conf
    else
        getent group gearbench >/dev/null && return 0
        systemd-sysusers gearbench.conf
        # udev may have read the rule already and dropped the group's lines; the reload
        # re-reads a changed file only.
        touch -c /usr/lib/udev/rules.d/70-g502x.rules
    fi
    echo "gearbench: with host mode off, the G502 X PLUS's G4 to G9 need your account" \
        "in the gearbench group: run sudo usermod -aG gearbench <you>, then log out of" \
        "every session and back in, or, with lingering on, restart the machine" >&2
}

if [ "$1" = "configure" ]; then
    make_group
fi

# udev reads /etc/udev/hwdb.bin over /usr/lib/udev/hwdb.bin. Where an /etc one is there, only
# a rebuild of it takes 71-gearbench-mouse-dpi.hwdb in or out of the hwdb udev reads. Where
# none is, udev's own dpkg trigger rebuilds /usr/lib's (systemd-hwdb --usr update), but only
# after this script's input trigger has read the old one, which leaves each mouse without the
# entry until it is plugged in again (measured on a first install, 2026-10-27); so the rebuild
# is made here first, as install.sh's hwdb_update does.
hwdb_update() {
    command -v systemd-hwdb >/dev/null 2>&1 || return 0
    if [ -e /etc/udev/hwdb.bin ]; then
        systemd-hwdb update || true
    else
        systemd-hwdb --usr update || true
    fi
}

# Before the reload, so the input trigger gives each mouse the entry; with udev not running
# too, as in a chroot, since udev reads the hwdb at its next start.
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ]; then
    hwdb_update
fi

# 1.2.1 and earlier granted the node hid-logitech-dj gives each device paired to the G915's
# or G915 TKL's receiver. The triggers below leave such a node out, but take back no ACL
# already on it, and at a seat switch logind moves only the ACLs of nodes still tagged: the
# node stays open to the account that had the seat until the receiver is plugged in again or
# the machine restarts. The G915 TKL's own node keeps its grant, so the check leaves it out.
# A device whose own rule grants its node keeps its grant too, but the check reads no rules
# and still warns.
paired_notice() {
    for paired in /sys/bus/hid/devices/0003:046D:C541.*/0003:* \
        /sys/bus/hid/devices/0003:046D:C545.*/0003:*
    do
        case "$paired" in */0003:046D:408E.*) continue ;; esac
        [ -e "$paired" ] || continue
        echo "gearbench: plug the G915's or G915 TKL's receiver in again, or restart the" \
            "machine: until then, the account that had the seat can still open each device" \
            "paired to that receiver, as the earlier udev rules allowed" >&2
        return 0
    done
}

# All three triggers are needed: a usb trigger does not re-run the hidraw rules, input gives
# each mouse's event node its hwdb entry and the G502 X PLUS's the gearbench group, and misc
# covers /dev/uinput. install.sh runs the same four commands.
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/udev ]; then
    udevadm control --reload || true
    udevadm trigger --subsystem-match=hidraw --action=add || true
    udevadm trigger --subsystem-match=input --action=add || true
    udevadm trigger --subsystem-match=misc --sysname-match=uinput --action=add || true
    # Each release up to 1.2.1 is named: all are native versions, with no revision.
    case "$2" in
        0.*|1.0.*|1.1.*|1.2.0|1.2.1) paired_notice ;;
    esac
fi

# Rules a checkout install left in /usr/local override this package's of the same
# names: checkout-rules warns of them. sh reads it, so an install into another root
# runs no program from that root.
if [ "$1" = "configure" ]; then
    sh "$DPKG_ROOT/usr/lib/gearbench/checkout-rules" "$DPKG_ROOT/usr/local/lib/udev/rules.d"
fi

#DEBHELPER#

# After debhelper's lines, whose enable reloads no user manager: the helper reloads each
# running one. dpkg calls configure with no earlier version on a first install, and passes
# the removed version to a reinstall after a remove, whose daemons prerm stopped, so
# preinst's mark stands for "no earlier version": both start the daemons, and an upgrade
# restarts them. The mark goes once the start is done, so a postinst cut short during it
# starts them again when dpkg runs it next.
if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
    if [ -e /run/gearbench-was-removed ] || [ -z "$2" ]; then
        /usr/lib/gearbench/user-daemons start
        rm -f /run/gearbench-was-removed
    else
        /usr/lib/gearbench/user-daemons restart
    fi
fi
