#!/bin/sh
set -e

# On a remove, and a purge, which removes first, the helper stops the Gearbench units of
# each running user manager before their code goes (the owner's decision of 2026-10-16).
# An upgrade calls this with "upgrade", and postinst restarts the running daemon on the
# new code.
if [ "$1" = "remove" ] && [ -z "$DPKG_ROOT" ] && [ -d /run/systemd/system ]; then
    /usr/lib/gearbench/user-daemons stop
fi

#DEBHELPER#
