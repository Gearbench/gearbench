#!/usr/bin/make -f
# Build with pybuild against pyproject.toml. The package is arch-independent
# Python with no compiled parts. pybuild installs only what pyproject.toml
# builds: the user units are made below and dh_installsystemduser installs
# them; debian/gearbench.install, .docs and .manpages place the rest.

# dh_installsystemduser names the installed unit after the package:
# usr/lib/systemd/user/gearbench.service.
UNIT = debian/gearbench.user.service
SPATIAL_UNIT = debian/gearbench.gearbench-spatial.user.service

%:
	dh $@ --with python3 --buildsystem=pybuild

# The unit in systemd/ carries @CHECKOUT@ because install.sh points it at a git
# checkout. A packaged install has the code on the system path and an entry
# point in /usr/bin, so WorkingDirectory= has nothing to say and ExecStart= is
# absolute. Its PYTHONPATH= line becomes an unset of the one the session
# exported. In the daemon's unit that is a second guard, since its console
# script runs with -I (below). In the spatial unit, whose ExecStart runs
# python3 -s -P, an empty element ("$PYTHONPATH:/opt/x" with none set before)
# names the working directory, $HOME, which -P leaves on sys.path.
# The greps are guards: a templated unit that reached a .deb would start a
# daemon that cannot import itself, one without the settings folder's
# ExecStartPre would fail every start where ReadWritePaths= applies, and one
# without the runtime folder's would let the daemon start below another
# account's folder, which its user namespace hides.
execute_after_dh_auto_build:
	sed -e 's|^Environment="PYTHONPATH=.*|UnsetEnvironment=PYTHONPATH PYTHONHOME|' \
	    -e '/^WorkingDirectory=/d' \
	    -e 's|^ExecStart=.*|ExecStart=/usr/bin/gearbench-ctl daemon|' \
	    systemd/gearbench.service > $(UNIT)
	! grep -q @CHECKOUT@ $(UNIT)
	grep -qx 'ExecStart=/usr/bin/gearbench-ctl daemon' $(UNIT)
	grep -qx 'ExecStartPre=+/usr/bin/install -d -m 0700 %E/gearbench' $(UNIT)
	grep -qx 'ExecStartPre=+/usr/bin/python3 -s -P -m gearbench.runtime_folder' $(UNIT)
	grep -qx 'UnsetEnvironment=PYTHONPATH PYTHONHOME' $(UNIT)
	sed -e 's|^Environment="PYTHONPATH=.*|UnsetEnvironment=PYTHONPATH PYTHONHOME|' \
	    spatial/gearbench-spatial.service.in > $(SPATIAL_UNIT)
	! grep -q '@[A-Z_]*@' $(SPATIAL_UNIT)
	grep -qx 'UnsetEnvironment=PYTHONPATH PYTHONHOME' $(SPATIAL_UNIT)
	grep -qx 'ExecStart=/usr/bin/python3 -s -P -m gearbench.spatial_unit run %t/gearbench-spatial.conf' $(SPATIAL_UNIT)

# The console script, which the unit, the desktop entry and D-Bus start, runs
# with -I: no PYTHON* variable and no user site-packages from the session,
# where an empty PYTHONPATH element names the working directory, $HOME. The
# grep is the guard that dh_python3 wrote the line.
override_dh_python3:
	dh_python3 --shebang='/usr/bin/python3 -I'
	head -n1 debian/gearbench/usr/bin/gearbench-ctl | grep -qx '#! /usr/bin/python3 -I'

# The daemon's unit enabled for every account: at the login
# screen the daemon exits before it opens a device, where python3-gi lets it
# read the session's class. The spatial one installed off, since the Headset
# tab switches it on per account. This order: a plain call after the named
# one would enable both.
override_dh_installsystemduser:
	dh_installsystemduser
	dh_installsystemduser --name=gearbench-spatial --no-enable

# README.md and SECURITY.md link docs/GUIDE.md, which links both back, as the
# repository lays them out; the README also links the images, the icon, spatial/
# and LICENSE. In /usr/share/doc/gearbench the three pages and images/ sit side
# by side, the other files are where debian/gearbench.install puts them and the
# license text is in /usr/share/common-licenses, so the installed copies link
# those places. They stay uncompressed, or a link to one would lead nowhere.
# The grep stops the build if a link of a form rewritten here is left.
DOC = debian/gearbench/usr/share/doc/gearbench
execute_after_dh_installdocs:
	sed -i -e 's|](docs/GUIDE\.md|](GUIDE.md|g' -e 's|](docs/images/|](images/|g' \
	    -e 's|](desktop/icons/scalable/|](/usr/share/icons/hicolor/scalable/apps/|g' \
	    -e 's|](spatial/|](/usr/share/gearbench/spatial/|g' \
	    -e 's|](LICENSE)|](/usr/share/common-licenses/GPL-3)|g' \
	    $(DOC)/README.md $(DOC)/SECURITY.md
	sed -i -e 's|](\.\./README\.md|](README.md|g' -e 's|](\.\./SECURITY\.md|](SECURITY.md|g' \
	    $(DOC)/GUIDE.md
	! grep -q -e '](docs/' -e '](\.\./' -e '](desktop/' -e '](spatial/' -e '](LICENSE)' \
	    $(DOC)/*.md

override_dh_compress:
	dh_compress -X.md

# The test suite needs no display (the widget tests start their own broadway
# server, or skip), and it imports GTK 4 and libadwaita, which Build-Depends
# names for the build that runs it, with dbus-daemon, which the desktop tests
# start two of, or skip. It needs tests/ beside the package, which
# pybuild's build tree does not have; the public source has no tests/, and
# its build skips them.
override_dh_auto_test:
	if [ -d tests ]; then python3 -m unittest discover -s tests; fi
