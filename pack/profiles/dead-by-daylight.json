{
  "version": 2,
  "name": "Dead by Daylight",
  "processes": [
    "DeadByDaylight-Win64-Shipping.exe",
    "DeadByDaylight.exe"
  ],
  "lighting": {
    "c33e": {
      "mode": "perkey",
      "effect": "static",
      "base": "#ff0000",
      "background": "#121212",
      "keys": {
        "1": "#00e5ff",
        "2": "#00e5ff",
        "A": "#ff0000",
        "D": "#ff0000",
        "E": "#8a00ff",
        "ESC": "#0050ff",
        "G1": "#ffe000",
        "G2": "#ffe000",
        "G3": "#ffe000",
        "G4": "#ffe000",
        "G5": "#ffe000",
        "LEFT CTRL": "#00ff30",
        "LEFT SHIFT": "#00ff30",
        "R": "#8a00ff",
        "S": "#ff0000",
        "SPACE": "#8a00ff",
        "W": "#ff0000"
      }
    }
  }
}
