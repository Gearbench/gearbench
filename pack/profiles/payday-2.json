{
  "version": 2,
  "name": "Payday 2",
  "processes": [
    "PAYDAY2.exe",
    "payday2_win32_release.exe"
  ],
  "lighting": {
    "c33e": {
      "mode": "perkey",
      "effect": "static",
      "base": "#ff0000",
      "background": "#121212",
      "keys": {
        "1": "#ff7000",
        "2": "#ff7000",
        "3": "#ff7000",
        "4": "#8a00ff",
        "A": "#ff0000",
        "C": "#ff7000",
        "D": "#ff0000",
        "E": "#8a00ff",
        "ENTER": "#0050ff",
        "F": "#8a00ff",
        "G": "#8a00ff",
        "G1": "#ffe000",
        "G2": "#ffe000",
        "G3": "#ffe000",
        "G4": "#ffe000",
        "G5": "#ffe000",
        "LEFT CTRL": "#00ff30",
        "LEFT SHIFT": "#00ff30",
        "Q": "#8a00ff",
        "R": "#8a00ff",
        "S": "#ff0000",
        "SPACE": "#ff0000",
        "T": "#00e5ff",
        "TAB": "#0050ff",
        "V": "#8a00ff",
        "W": "#ff0000"
      }
    }
  },
  "mouse_color": "#8a00ff"
