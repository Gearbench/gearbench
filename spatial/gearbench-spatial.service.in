[Unit]
Description=Gearbench - Gearbench Spatial, a 7.1 output for headphones
# Runs from the login on once switched on, in the window's Headset tab or with
# `gearbench-ctl headset-spatial on`; an install never switches it on. Its
# process follows PipeWire and runs the chain only while a headset Gearbench
# plays to is there, so it needs no device unit: one unit serves every
# headset.
# A client of the session's PipeWire, stopped and restarted with it, as
# PipeWire's own filter-chain.service is.
BindsTo=pipewire.service
After=pipewire.service pipewire-session-manager.service
# One that fails at every start is left failed after five tries in a minute;
# the Headset tab and `gearbench-ctl headset-spatial` then say so.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Lets the process say why it runs no chain for a headset that is there, as
# the unit's status, which the Headset tab and `gearbench-ctl
# headset-spatial` show.
NotifyAccess=main
Environment="PYTHONPATH=@CHECKOUT@"
# Renders the chain from Gearbench's template, the head, room and headset
# saved in spatial.json and the output it plays to, and runs it, each time
# that output changes: a change of the head or the headset is a restart. -s
# keeps user site-packages off sys.path, so the package's gearbench, or the
# checkout's on PYTHONPATH, renders the chain.
ExecStart=/usr/bin/python3 -s -P -m gearbench.spatial_unit run %t/gearbench-spatial.conf
Restart=on-failure
RestartSec=2
SyslogIdentifier=gearbench-spatial
Slice=session.slice
# The hardening PipeWire's filter-chain.service carries.
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=default.target
