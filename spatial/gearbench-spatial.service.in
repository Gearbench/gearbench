[Unit]
Description=Gearbench - Astro A50 Spatial, a 7.1 output for headphones on Astro A50 Game
# Runs only while the A50's base station is plugged in: this is the user
# manager's device unit for /dev/snd/by-id/usb-Astro_Gaming_Astro_A50-00,
# which systemd's own rules make for every sound card. Its WantedBy= starts
# it when the base station is plugged in; gearbench-spatial-login.service
# starts it at login when the base station already is. Enabled by the
# window's Headset tab or `gearbench-ctl headset-spatial on`, never at
# install.
BindsTo=dev-snd-by\x2did-usb\x2dAstro_Gaming_Astro_A50\x2d00.device
After=dev-snd-by\x2did-usb\x2dAstro_Gaming_Astro_A50\x2d00.device
# A client of the session's PipeWire, stopped and restarted with it, as
# PipeWire's own filter-chain.service is.
BindsTo=pipewire.service
After=pipewire.service pipewire-session-manager.service
# One that fails at every start is left failed after five tries in a minute;
# the Headset tab and `gearbench-ctl headset-spatial` then say so.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment="PYTHONPATH=@CHECKOUT@"
# Written at every start from Gearbench's template and the head and room saved
# in spatial.json: a head change is a restart, and a new template applies at
# the next start. -s keeps user site-packages off sys.path, so the package's
# gearbench, or the checkout's on PYTHONPATH, renders the chain.
ExecStartPre=/usr/bin/python3 -s -P -m gearbench.spatial render %t/gearbench-spatial.conf
ExecStart=/usr/bin/pipewire -c %t/gearbench-spatial.conf
Restart=on-failure
RestartSec=2
SyslogIdentifier=gearbench-spatial
Slice=session.slice
# The hardening PipeWire's filter-chain.service carries.
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=dev-snd-by\x2did-usb\x2dAstro_Gaming_Astro_A50\x2d00.device
Also=gearbench-spatial-login.service
